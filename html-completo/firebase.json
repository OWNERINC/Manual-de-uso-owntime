{
  "hosting": {
    "target": "v2",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "compress-images.mjs",
      "package.json",
      "package-lock.json",
      "node_modules/**",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(webp|png|jpg|jpeg|svg|gif)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
